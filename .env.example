# Termany configuration — copy to .env and adjust as needed.
# All values are optional; the defaults below match `npm run dev`.
#
# Model-provider API keys are NOT configured here — they are entered in the app
# (BYOK) and stored locally in ~/.termany/termany.db.

# --- Server (apps/server) ---
# PTY/API server port.
TERMANY_PORT=5174
# Interface to bind. Defaults to 127.0.0.1 — the server hosts a PTY, file
# read/write and every pane's scrollback with no authentication, so it should
# not be reachable from the network. Set this only if you deliberately want a
# remote client (see VITE_PTY_URL below), and put it behind something that
# authenticates.
# TERMANY_BIND=127.0.0.1
# Extra browser origins allowed to call the API, comma-separated. The app's own
# origins are always allowed; this is an escape hatch for an unusual webview
# build. Blocked requests are logged with the exact origin they sent.
# TERMANY_ALLOWED_ORIGINS=
# Directory where pasted images are written (defaults to the system temp dir).
# TERMANY_PASTE_DIR=

# --- Web client (apps/web, Vite) ---
# Where the web client reaches the PTY WebSocket and REST API.
# 127.0.0.1 rather than `localhost`: the server's primary bind is IPv4 loopback
# and the [::1] listener beside it is best-effort, so name the address directly.
VITE_PTY_URL=ws://127.0.0.1:5174
VITE_API_URL=http://127.0.0.1:5174
